{
  "author": {
    "name": "Robert Lindley"
  },
  "bugs": {
    "url": "https://github.com/Coderrob/eslint-config-zero-tolerance/issues"
  },
  "dependencies": {
    "comment-parser": "^1.4.9"
  },
  "description": "Strict, opinionated ESLint rules for TypeScript — enforcing type safety, code quality, testing standards, and maintainable patterns with zero exceptions.",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@typescript-eslint/types": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "homepage": "https://github.com/Coderrob/eslint-config-zero-tolerance/",
  "imports": {
    "#plugin-package": "./package.json"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "typescript",
    "typescript-eslint",
    "code-quality",
    "type-safety",
    "strict",
    "zero-tolerance",
    "linting",
    "testing",
    "jsdoc",
    "best-practices",
    "imports",
    "naming-conventions"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "name": "@coderrob/eslint-plugin-zero-tolerance",
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "directory": "packages/plugin",
    "type": "git",
    "url": "git+https://github.com/Coderrob/eslint-config-zero-tolerance.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify && node ../../scripts/sync-dts-variants.mjs index",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepack": "pnpm run build",
    "publish:public": "pnpm publish --access public",
    "test": "jest --coverage --runInBand"
  },
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "version": "1.2.9"
}
