{
  "author": {
    "name": "Robert Lindley"
  },
  "description": "Monorepo for @coderrob/eslint-plugin-zero-tolerance and @coderrob/eslint-config-zero-tolerance — strict ESLint rules and config presets for TypeScript code quality.",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "ajv": "^8.20.0",
    "eslint": "catalog:",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "knip": "^6.44.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tinyexec": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslint-config",
    "typescript",
    "code-quality",
    "zero-tolerance",
    "strict",
    "linting"
  ],
  "license": "Apache-2.0",
  "name": "eslint-config-zero-tolerance",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "clean": "pnpm -r clean",
    "deps:circular": "madge --extensions ts --circular packages/plugin/src/index.ts",
    "deps:graph": "madge --extensions ts packages/plugin/src/index.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm build && eslint . && pnpm validate:dead-code && pnpm validate:bdd && pnpm validate:rules && pnpm validate:readme && pnpm validate:publint",
    "lint:fix": "pnpm build && eslint . --fix && pnpm format",
    "readme:sync": "pnpm --filter @coderrob/eslint-plugin-zero-tolerance build && eslint-doc-generator packages/plugin",
    "release:publish": "pnpm build && pnpm test && pnpm release:publish:plugin",
    "release:publish:plugin": "pnpm --filter @coderrob/eslint-plugin-zero-tolerance run publish:public",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:compat": "node scripts/test-package-compatibility.mjs",
    "validate:bdd": "node scripts/validate-bdd-specs.mjs",
    "validate:dead-code": "knip",
    "validate:readme": "pnpm --filter @coderrob/eslint-plugin-zero-tolerance build && eslint-doc-generator packages/plugin --check",
    "validate:rules": "node scripts/validate-rule-naming.mjs",
    "validate:publint": "publint packages/plugin && publint packages/config"
  },
  "version": "1.0.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
