{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  // These are parsed lint inputs; example imports are not runtime dependencies.
  "ignore": ["test/consumers/rule-contracts/**/*.ts"],
  "workspaces": {
    ".": {
      "entry": [
        ".eslint-doc-generatorrc.cjs",
        "scripts/*.mjs",
        "test/consumers/**/.eslintrc.cjs",
        "test/consumers/**/*.{cjs,mjs,cts,mts,ts}",
      ],
      "project": [
        "scripts/**/*.mjs",
        "test/consumers/**/.eslintrc.cjs",
        "test/consumers/**/*.{cjs,mjs,cts,mts,ts}",
      ],
    },
    "packages/plugin": {
      // Repository convention requires every rule to expose matching named and default exports.
      "ignoreIssues": {
        "src/rules/*.ts": ["duplicates"],
      },
    },
  },
}
